---
layout: none
---
[
{%- assign first = true -%}
{%- for project in site.data.featured_projects -%}
  {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
  {
    "title": {{ project.title | jsonify }},
    "tags": {{ project.tags | join: ", " | jsonify }},
    "url": {{ project.url | jsonify }},
    "date": "Project",
    "description": {{ project.description | jsonify }},
    "type": "page"
  }
{%- endfor -%}
{%- for post in site.posts -%}
  {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
  {
    "title": {{ post.title | jsonify }},
    "tags": {{ post.tags | join: ", " | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%b %Y" | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 180 | jsonify }},
    "type": "post"
  }
{%- endfor -%}
{%- for book in site.data.books -%}
  {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
  {%- if book.summary_url -%}
    {%- assign book_url = book.summary_url -%}
  {%- elsif book.year -%}
    {%- assign book_url = "/reading/#year-" | append: book.year -%}
  {%- else -%}
    {%- assign book_url = "/reading/#curated" -%}
  {%- endif -%}
  {
    "title": {{ book.title | jsonify }},
    "author": {{ book.author | jsonify }},
    "tags": {{ book.category | default: "" | jsonify }},
    "url": {{ book_url | jsonify }},
    "date": {{ book.year | default: "" | append: "" | jsonify }},
    "description": {{ book.blurb | default: book.author | jsonify }},
    "cover": {{ book.cover | default: "" | jsonify }},
    "hasNotes": {% if book.summary_url %}true{% else %}false{% endif %},
    "type": "book"
  }
{%- endfor -%}
{%- assign pages_to_exclude = '/404.html,/search/,/posts/,/thank-you/,/tags/,/newsletter-confirm,/newsletter-unsubscribe,/reading/seed-to-harvest/' | split: ',' -%}
{%- for p in site.pages -%}
  {%- assign skip_page = false -%}
  {%- if p.layout == nil or p.title == nil or p.title == "" -%}{%- assign skip_page = true -%}{%- endif -%}
  {%- if pages_to_exclude contains p.url -%}{%- assign skip_page = true -%}{%- endif -%}
  {%- if p.url contains '/assets/' or p.url contains '/Book-Summaries/' or p.url contains '/Book-library/' or p.url == '/' -%}{%- assign skip_page = true -%}{%- endif -%}
  {%- unless skip_page -%}
    {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
    {
      "title": {{ p.title | jsonify }},
      "tags": {{ p.tags | join: ", " | jsonify }},
      "url": {{ p.url | prepend: site.baseurl | jsonify }},
      "date": "",
      "description": {{ p.description | default: p.excerpt | strip_html | normalize_whitespace | truncate: 220 | jsonify }},
      "type": "page"
    }
  {%- endunless -%}
{%- endfor -%}
]
